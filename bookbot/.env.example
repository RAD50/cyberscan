# Bot
TELEGRAM_BOT_TOKEN=

# Security
# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to disable whitelist (open mode — anyone can use the bot).
ALLOWED_USER_IDS=

# Comma-separated Telegram user IDs with admin privileges.
ADMIN_USER_IDS=

# Logging
LOG_LEVEL=INFO
LOG_UNAUTHORIZED=true

# Scraper
REQUEST_TIMEOUT=15
MAX_RESULTS_PER_SITE=3
